rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Tasks collection: user can only access and modify their own tasks
    match /tasks/{taskId} {
      allow read: if isAdmin();
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    // User profiles: each user writes their own; admins read all
    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Admins are added by hand in the Firebase console
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    // Backward compatibility for legacy notes
    match /notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}
